<Project>

 <!--Verwendete .NET-Version-->
 <PropertyGroup>
  <TargetFramework>net11.0</TargetFramework>
 </PropertyGroup>

 <!--App-Version-->
 <PropertyGroup>
  <Version>11.1.0</Version>
  <AssemblyVersion>11.1.0</AssemblyVersion>
  <FileVersion>11.1.0</FileVersion>
  <InformationalVersion>11.1.0-11/11/2026 20:50:16</InformationalVersion>
  <ApplicationVersion>11</ApplicationVersion>
  <ApplicationDisplayVersion>11.1.0</ApplicationDisplayVersion>
 </PropertyGroup>

 <!--App-Infos-->
 <PropertyGroup>
  <Authors>Dr. Holger Schwichtenberg (www.IT-Visions.de)</Authors>
  <Company>www.IT-Visions.de</Company>
  <Product>MiracleList</Product>
  <Copyright>(C) Dr. Holger Schwichtenberg (www.IT-Visions.de)</Copyright>
  <PackageProjectUrl>https://www.miraclelist.net</PackageProjectUrl>
  <PackageReleaseNotes>Programmcodebeispiele zum Blazor 11.0-Buch von Dr. Holger Schwichtenberg für Buchversion 11.1.0</PackageReleaseNotes>
 </PropertyGroup>

 <!--Aktuell keine NuGet-Sicherheits-Warnungen-->
 <PropertyGroup>
  <NuGetAudit>false</NuGetAudit>
  <!--<NuGetAuditLevel>critical</NuGetAuditLevel>-->
  <!--Nur kritische NuGet-Sicherheits-Warnungen-->
 </PropertyGroup>
 
 <!--Für neuen Roslyn C# Tokenizer in Blazor-->
 <PropertyGroup>
  <Features>use-roslyn-tokenizer;$(Features)</Features>
 </PropertyGroup>

 <PropertyGroup>
  <NoWarn>1701;1702;1998;HTML00004;CS1591</NoWarn>
  <WarningsAsErrors>$(WarningsAsErrors);RZ2012</WarningsAsErrors>  <!--fehlende Komponentenparameter sollen nicht nur Warnung sein!-->
 </PropertyGroup>
 
</Project>