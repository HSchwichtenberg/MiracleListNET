@using ITVisions.Blazor.Controls
@using ITVisions
@using ITVisions.Metadata

<Debug>
 FormElements=@FormElements.Count Pages=@Pages.Count
</Debug>

@if (FormElements != null && FormElements.Any())
{

 <EditForm Model="this" OnValidSubmit="OnSubmit">

  @* Seiten-Navigation anzeigen, wenn mehrere Seiten vorhanden sind *@
  @if (Pages.Count > 1)
  {
   <div class="page-header mb-4">
    <h3>Seite @(CurrentPageIndex + 1) von @Pages.Count: @Pages[CurrentPageIndex].PageName</h3>

    @* Fortschrittsanzeige *@
    <div class="progress mt-3" style="height: 25px;">
     @{
      var progressPercentage = ITVisions.MathUtil.PerCent(CurrentPageIndex + 1, Pages.Count);
     }
     <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning"
     role="progressbar"
     style="width: @(progressPercentage)%"
     aria-valuenow="@(CurrentPageIndex + 1)"
     aria-valuemin="0"
     aria-valuemax="@Pages.Count">
      <strong>@ITVisions.MathUtil.PerCentString(CurrentPageIndex + 1, Pages.Count)</strong>
     </div>
    </div>
   </div>
  }

  @* Aktuelle Seite rendern *@
  @if (Pages.Count > 0 && CurrentPageIndex < Pages.Count)
  {
   var currentPage = Pages[CurrentPageIndex];

   @* Felder der aktuellen Seite mit Gruppen-Support *@
   var processedIndices = new HashSet<int>();

   for (int i = 0; i < currentPage.Fields.Count; i++)
   {
    if (processedIndices.Contains(i)) continue;

    var field = currentPage.Fields[i];

    @* Headline innerhalb der Seite *@
    if (field.Type == FormElementType.Headline)
    {
     var isCollapsed = CollapsedSections.Contains(field.Key);
     <h4 class="headline" @onclick="@(() => ToggleSection(field.Key))" style="cursor: pointer; user-select: none;">
      <i class="bi bi-chevron-@(isCollapsed ? "down" : "right") me-2"></i>
      @field.Label
     </h4>
     processedIndices.Add(i);
     continue;
    }

    @* Prüfe ob das Feld angezeigt werden soll (nicht eingeklappt) *@
    var parentHeadline = GetParentHeadline(field, currentPage.Fields);
    var shouldShow = parentHeadline == null || !CollapsedSections.Contains(parentHeadline.Key);

    if (!shouldShow)
    {
     processedIndices.Add(i);
     continue;
    }

    if (field.Type == FormElementType.Info)
    {
     @* ---- Info-Text (in Markdown) *@
     <div class="mb-3">
      @((MarkupString)ITVisions.Web.HTMLUtil.MarkDownToHTML(field.Label))
     </div>
     processedIndices.Add(i);
     continue;
    }

    @* Prüfe, ob dieses Feld Teil einer Gruppe ist *@
    if (!string.IsNullOrEmpty(field.Group))
    {
     // Sammle alle Felder mit derselben Gruppe
     var groupFields = new List<FormElement>();
     var isAutoGroup = field.Group.Contains("__auto_group_") || field.Group.StartsWith("auto_group_");

     for (int j = i; j < currentPage.Fields.Count; j++)
     {
      var groupField = currentPage.Fields[j];

      // Prüfe ob das Feld angezeigt werden soll
      var groupParentHeadline = GetParentHeadline(groupField, currentPage.Fields);
      var groupShouldShow = groupParentHeadline == null || !CollapsedSections.Contains(groupParentHeadline.Key);

      // Stoppe, wenn wir auf ein strukturelles Element treffen
      if (groupField.Type == FormElementType.Headline ||
          groupField.Type == FormElementType.Chapter ||
          groupField.Type == FormElementType.Info)
      {
       break;
      }

      // Stoppe, wenn Gruppe wechselt
      if (groupField.Group != field.Group)
      {
       break;
      }

      if (groupShouldShow)
      {
       groupFields.Add(groupField);
      }
      processedIndices.Add(j);
     }

     @* Rendere Feldgruppe horizontal *@
     if (groupFields.Any())
     {
      <div class="mb-3">
       @if (!isAutoGroup)
       {
        <label class="fw-bold group-label mb-2">@field.Group</label>
       }
       <div class="row g-3">
        @foreach (var groupField in groupFields)
        {
         <div class="col-sm-@(12 / groupFields.Count) col-12">
          @RenderSingleField(groupField)
         </div>
        }
       </div>
      </div>
     }
    }
    else
    {
     @* Einzelfeld ohne Gruppe *@
     <div class="form-group">
      @RenderSingleField(field)
     </div>
     processedIndices.Add(i);
    }
    }
   }

   <div class="mt-4 pt-3 border-top">

   @* Validierungsfehler ausgeben *@
   @if (!string.IsNullOrEmpty(ValidationErrorMessage))
   {
    <div class="alert alert-danger" role="alert">
     @((MarkupString)ValidationErrorMessage)
    </div>
   }

   @* Navigation und Submit Buttons *@
   <div class="d-flex align-items-center">
    @if (Pages.Count > 1)
    {
     @if (CurrentPageIndex > 0)
     {
      <button type="button" class="btn btn-secondary me-2" @onclick="PreviousPage" disabled="@(CurrentPageIndex == 0)">
       <i class="bi bi-arrow-left"></i> Vorherige Seite
      </button>
     }
     @if (CurrentPageIndex < Pages.Count - 1)
     {
      <button type="button" class="btn btn-primary me-2" @onclick="NextPage">
       Nächste Seite <i class="bi bi-arrow-right"></i>
      </button>
     }
     else if (ShowSubmitButton)
     {
      <ITVButton type="submit" class="btn btn-primary me-2">
       <i class="bi bi-check-circle"></i> @SubmitButtonText
      </ITVButton>
     }
    }
    else if (ShowSubmitButton)
    {
     <div class="ms-auto">
      <ITVButton type="submit" class="btn btn-primary">
       <i class="bi bi-check-circle"></i> @SubmitButtonText
      </ITVButton>
     </div>
    }

   </div>
  </div>
 </EditForm>

 @* Debug-Ausgabe *@
 <Debug>
  <div class="card">
   <div class="card-header">
    <h5>Debug: FormElements (@FormElements?.Count Elemente)</h5>
   </div>
   <div class="card-body">
    <small>
     @if (FormElements != null)
     {
      <table class="table table-sm table-striped">
       <thead>
        <tr>
         <th>Key</th>
         <th>Label</th>
         <th>Type</th>
         <th>Value</th>
         <th>Required</th>
         <th>Regex</th>
         <th>Options</th>
        </tr>
       </thead>
       <tbody>
        @foreach (var element in FormElements)
        {
         <tr>
          <td><code>@element.Key</code></td>
          <td>@element.Label</td>
          <td><span class="badge bg-secondary">@element.Type</span></td>
          <td>@element.Value</td>
          <td>@(element.Required ? "✓" : "")</td>
          <td><code>@element.Regex</code></td>
          <td>@(element.Options?.Any() == true ? string.Join(", ", element.Options) : "")</td>
         </tr>
        }
       </tbody>
      </table>
     }
    </small>
   </div>
  </div></Debug>
}