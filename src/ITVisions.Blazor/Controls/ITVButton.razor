@inject BlazorUtil util

<button disabled="@ShowAnimation" data-toggle="tooltip" data-placement="bottom" @attributes="AdditionalAttributes" @onclick="Run">
 @if (ShowAnimation)
 {
  <text>
   <img src="/_content/ITVisions.Blazor/img/ITVButtonProgress.gif" width="20" style="margin-right:8px;" />
  </text>
 }
 @ChildContent
</button>

@code {
 /// <summary>
 /// Inhalt der Schaltfläche
 /// </summary>
 [Parameter] public RenderFragment ChildContent { get; set; }

 /// <summary>
 ///  Anzahl der Mindestsekunden für die Deaktivierung und Animation
 /// </summary>
 [Parameter] public byte AnimationSeconds { get; set; } = 1;

 /// <summary>
 /// Weitergabe sonstiger Attribute, z.B. class und style
 /// </summary>
 [Parameter(CaptureUnmatchedValues = true)]
 public IDictionary<string, object> AdditionalAttributes { get; set; }

 /// <summary>
 /// Aktion bei Klick
 /// </summary>
 [Parameter]
 public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> onClick { get; set; }

 /// <summary>
 /// Aktion bei Fehler
 /// </summary>
 [Parameter]
 public EventCallback<Exception> onError { get; set; }

 bool ShowAnimation = false;
 bool Working = false;

 public async Task Run()
 {
  // Start animation
  ShowAnimation = true;
  Working = true;
  await UIUpdate();

  Task minDelay = AnimationSeconds > 0 ? Task.Delay(TimeSpan.FromSeconds(AnimationSeconds)) : Task.CompletedTask;

  async Task ActionRunner()
  {
   // hier startet die Aktion!
   await onClick.InvokeAsync();
  }

  try
  {
   // Die Animation läuft so lange, wie die Aktion läuft, und mindestens AnimationSeconds.
   await Task.WhenAll(ActionRunner(), minDelay);
  }
  catch (Exception ex)
  {
   // Bei Fehler die Animation sofort beenden
   ShowAnimation = false;
   await UIUpdate();

   if (onError.HasDelegate) // Host hat Fehlerbehandlung definiert
   {
    await onError.InvokeAsync(ex);
   }
   else // Host hat keine Fehlerbehandlung definiert
   {
    util.Error(ex.ToString());
    await util.Alert(ex.GetFullMessage());
   }

   Working = false;
   return;
  }

  // Completed: stop animation
  Working = false;
  ShowAnimation = false;
  await UIUpdate();
 }

 /// <summary>
 /// Erzwingt neues Rendern
 /// </summary>
 public async Task UIUpdate()
 {
  await this.InvokeAsync(this.StateHasChanged);
  await Task.Delay(1);
 }
}