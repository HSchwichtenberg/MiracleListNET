@page "/Samples_BS/Demo_ITVRegion"
<h3>Nutzung der eigenen Komponente &lt;ITVRegion&gt;</h3>

@code {
 @code {
  bool region1Open;
  bool region2Open = true;
 }
}

Region ist auf: @region1Open<br>

Die Region ist von außen per Checkbox steuerbar:
<input type="checkbox" @bind="region1Open" />

<ITVRegion @bind-IsOpen="region1Open">
 <Head>
  Das ist die
  <i>Überschrift</i>
 </Head>
 <Content>
  Hier ist der Inhalt
  <ul>
   <li>Punkt 1</li>
   <li>Punkt 2</li>
  </ul>
 </Content>
</ITVRegion>

Region ist auf: @region2Open
<ITVRegion @bind-IsOpen="region2Open">
 <Head>
  Head
 </Head>
 <Content>
  Content
 </Content>

</ITVRegion>
