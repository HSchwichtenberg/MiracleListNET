<div class="panel panel-default">
 <div class="panel-heading">
  <h4>Komponente "Login"</h4>
 </div>

 <div class="panel-body">
  <p>
   Diese Razor Component <b>@this.GetType().FullName</b> kommt aus der DLL: <b><text>@System.Reflection.Assembly.GetExecutingAssembly().GetName().Name</text>.dll</b>!
  </p>

  <EditForm Model="this" OnValidSubmit="LoginClick">
   <InputText @bind-Value="UserName"
              @bind-Value:after="@(async () => await UserNameChanged.InvokeAsync(UserName))"
              class="form-control" />

   <InputText @bind-Value="Password"
              type="password"
              @bind-Value:after="@(async () => await PasswordChanged.InvokeAsync(Password))"
              class="form-control" />

   <button class="btn btn-primary" type="submit">Login</button>
  </EditForm>

 </div>
</div>

@code {
 [Parameter]
 public string UserName { get; set; }
 [Parameter]
 public EventCallback<string> UserNameChanged { get; set; }

 [Parameter]
 public string Password { get; set; }
 [Parameter]
 public EventCallback<string> PasswordChanged { get; set; }

 [Parameter]
 public EventCallback OnLogin { get; set; }

 async Task LoginClick()
 {
  await OnLogin.InvokeAsync(null);
 }
}