@page "/samples/CounterHostV1"
@* https://localhost:5001/samples/CounterHostV1 *@

<h3>CounterHost (Datenweitergabe mit einzelnen Komponentenparametern)</h3>

<div class="row">

 <div class="col-md-3">
  <CounterPlus CounterState="@CounterState" CounterStateChanged="() => this.StateHasChanged()" />
 </div>

 <div class="col-md-3">
  <CounterMinus CounterState="@CounterState" CounterStateChanged="()=>this.StateHasChanged()" />
 </div>

 <div class="col-md-3">
  Host hat Wert: @CounterState.CurrentCount
 <button @onclick="() => CounterState.CurrentCount = 0" class="btn btn-default">Reset</button>
 </div>

</div>

@code
{
 //int currentCount = 42;
 CounterState CounterState = new() { CurrentCount = 42 };
}