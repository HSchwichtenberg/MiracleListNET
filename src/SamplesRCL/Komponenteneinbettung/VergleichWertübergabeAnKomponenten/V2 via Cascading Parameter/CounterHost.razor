@page "/samples/CounterHostV2"

@* https://localhost:5001/samples/CounterHostV2 *@

<h3>CounterHost (Datenweitergabe via Cascading Value/Cascading Parameter)</h3>

<div class="row">

 <CascadingValue Value="@CounterState">
  <div class="col-md-3">
   <CounterPlus CounterStateChanged="() => this.UIUpdate()" />
  </div>

  <div class="col-md-3">
   <CounterMinus CounterStateChanged="() => this.UIUpdate()" />
  </div>
 </CascadingValue>

 <div class="col-md-3">
  Host hat Wert: @CounterState.CurrentCount
  <button @onclick="() => CounterState.CurrentCount = 0" class="btn btn-default">Reset</button>
 </div>

</div>

@code
{
 //int currentCount = 42;

 CounterState CounterState = new() { CurrentCount = 42 };

 public async void UIUpdate()
 {
  Util.Log("UIUpdate in CounterHost");
  await InvokeAsync(StateHasChanged);
  await Task.Delay(1);
 }
}