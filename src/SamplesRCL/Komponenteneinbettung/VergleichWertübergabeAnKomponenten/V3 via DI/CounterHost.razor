@page "/samples/CounterHostV3"
@implements IDisposable

@inject CounterState CounterState

@* https://localhost:5001/samples/CounterHostV3 *@

<h3>CounterHost (Datenweitergabe via DI)</h3>

<div class="row">

 <div class="col-md-3">
  <CounterPlus />
 </div>

 <div class="col-md-3">
  <CounterMinus />
 </div>

 <div class="col-md-3">
  Host hat Wert: @CounterState.CurrentCount
  <button @onclick="() => CounterState.CurrentCount = 0" class="btn btn-default">Reset</button>
 </div>

</div>

<hr />
@foreach (var item in CounterState.CountHistory)
{
 <div>@item.Key: @item.Value</div>
}

@code
{
 //int currentCount = 42;

 //  CounterState CounterState = new() { CurrentCount = 42 };

 protected override void OnInitialized()
 {
  CounterState.CurrentCount = 42; 
  CounterState.OnChange += UIUpdate;
 }

 public void Dispose()
 {
  CounterState.OnChange -= UIUpdate;
 }

 public async void UIUpdate()
 {
  Util.Log("UIUpdate in CounterHost");
  await InvokeAsync(StateHasChanged);
  await Task.Delay(1);
 }
}