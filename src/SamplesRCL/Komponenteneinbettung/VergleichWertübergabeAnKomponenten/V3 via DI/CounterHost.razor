@page "/samples/CounterHostV3"
@implements IDisposable
@inherits ITVComponentBase

@inject CounterState CounterState

@* https://localhost:5101/samples/CounterHostV3 *@

<h3>CounterHost (Datenweitergabe via DI)</h3>

<div class="row">

 <div class="col-md-3">
  <CounterPlus />
 </div>

 <div class="col-md-3">
  <CounterMinus />
 </div>

 <div class="col-md-3">
  Host hat Wert: @CounterState.CurrentCount
  <button @onclick="() => CounterState.CurrentCount = 0" class="btn btn-warning">Reset</button>
 </div>

</div>

<hr />
@foreach (var item in CounterState.CountHistory)
{
 <div>@item.Key: @item.Value</div>
}

@code
{
 //int currentCount = 42;

 //  CounterState CounterState = new() { CurrentCount = 42 };

 protected override void OnInitialized()
 {
  CounterState.CurrentCount = 42; 
  CounterState.OnChange += UIUpdate;
 }

 public void Dispose()
 {
  CounterState.OnChange -= UIUpdate;
 }

}