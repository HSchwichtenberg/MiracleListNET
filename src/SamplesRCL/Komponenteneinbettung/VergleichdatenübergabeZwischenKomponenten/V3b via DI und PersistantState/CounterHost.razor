@page "/samples/CounterHostV3b"
@using System.Net.Http.Json
@implements IDisposable
@inherits ITVComponentBase

@inject CounterState CounterState
@inject PersistentComponentState ApplicationState

@* https://localhost:5101/samples/CounterHostV3 *@

<h3>CounterHost (Datenweitergabe via DI und Persistant State)</h3>

<div class="row">

 <div class="col-md-3">
  <CounterPlus />
 </div>

 <div class="col-md-3">
  <CounterMinus />
 </div>

 <div class="col-md-3">
  Host hat Wert: @CounterState.CurrentCount
  <button @onclick="() => CounterState.CurrentCount = 0" class="btn btn-warning">Reset</button>
 </div>

</div>

<hr />
@foreach (var item in CounterState.CountHistory)
{
 <div>@item.Key: @item.Value</div>
}

@code
{
 //int currentCount = 42;

 //  CounterState CounterState = new() { CurrentCount = 42 };

 private PersistingComponentStateSubscription? persistingSubscription;

 protected override void OnInitialized()
 {
  // Ensure we observe DI state changes
  CounterState.OnChange += CounterStateChanged;

  // Ist CounterState im Persistant Component State?
  try
  {
   if (ApplicationState.TryTakeFromJson<CounterState>("CounterState", out var persisted) && persisted != null)
   {
    CounterState.CountHistory = persisted.CountHistory ?? new();
    CounterState.CurrentCount = persisted.CurrentCount;
   }
  }
  catch
  {
   // ignore deserialization errors
  }

  // Persistieren bei Bedarf
  persistingSubscription = ApplicationState.RegisterOnPersisting(() =>
  {
   ApplicationState.PersistAsJson("CounterState", CounterState);
   return Task.CompletedTask;
  });
 }

 protected async override Task OnInitializedAsync()
 {
  System.Diagnostics.Trace.WriteLine("Rendermode: " + this.RendererInfo.Name);

  // Wenn 0, dann von Backend laden
  if (CounterState.CurrentCount == 0)
  {
   string baseURI = "https://worldwidewingsbackend.azurewebsites.net";
   HttpClient HttpClient = new HttpClient();
   CounterState.CurrentCount = await HttpClient.GetFromJsonAsync<int>(baseURI + "/api/flight/count");
   await Log(CounterState.CurrentCount);
  }
 }

 public void Dispose()
 {
  CounterState.OnChange -= CounterStateChanged;
  persistingSubscription?.Dispose();
 }

 private void CounterStateChanged()
 {
  UIUpdate();
 }

}