@page "/Samples/Countdown"
@using System.Threading;
@using ITVisions.Blazor
@inject BlazorUtil Util
@implements IDisposable

<h3>Countdown mit System.Threading.Timer</h3>
<div class="countdown-container">

    <div class="countdown-controls">
     @if(timer ==null)
     {
        <button @onclick="Start" class="btn btn-default" disabled="@(timer != null)">Start Countdown</button>
     }
     else
  {
   <button @onclick="End" class="btn btn-danger" disabled="@(timer == null)">Countdown abbrechen</button>
  }
  <span class="countdown-ausgabe">@Ausgabe</span>
    </div>

    <div class="countdown-number @(Count <= 0 ? "boom" : "")">
        @Count
    </div>

</div>

@code {
 private int Count { get; set; } = 10;
 private string Ausgabe { get; set; } = "";

 System.Threading.Timer timer; // Außerhalb wegen GC!
 void Start()
 {
  if (timer == null)
  {
   Count = 10;
   timer = new Timer(new TimerCallback(_ => Schritt()), null, 1000, 1000);
   Ausgabe = "Countdown läuft...";
  }
 }

 void Schritt()
 {
  // Calling StateHasChanged() from an arbitrary thread is not safe!!!
  this.InvokeAsync(
    () =>
    {
     if (Count == 0) 
     {
      End();
     }
     else
     {
      Count--;
      Util.Log(Count);
     }
     // Call to StateHasChanged() is necessary because otherwise
     // Blazor would not recognize the state change and not refresh the UI
     this.StateHasChanged();
    });
 }

 void End()
 {
  Ausgabe = "";
  timer.Dispose();
  timer = null;
 }

 public void Dispose()
 {
  // wichtig, damit Timer nicht weiterläuft, wenn die Komponente schon nicht mehr lebt
  if (timer != null) { 
   timer.Dispose(); 
   timer = null; }
 }
}