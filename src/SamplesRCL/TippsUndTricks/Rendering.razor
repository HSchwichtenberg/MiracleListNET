@page "/Samples/Rendering"
@using System.Threading;
@using ITVisions.Blazor
@using ITVisions.Blazor.Controls
@inject BlazorUtil Util

<h1>Rendering in @(Util.IsWebAssembly ? "Blazor WebAssembly" : "Blazor Server")</h1>

<h3>Einstellungen</h3>

<br />
<input type="number" @bind="Dauer" class="form-control" style="width:100px" /> Sekunden
<br />
<input type="checkbox" @bind="shouldRender" class="form-check-input" /> ShouldRender? --> ohne dies sieht man gar keine UI-Updates (außer dem Animated GIF in der Schaltfläche)
<br />
<input type="checkbox" @bind="useTask" class="form-check-input" /> Use Task?
<br />
<input type="checkbox" @bind="callStateHasChanged" class="form-check-input" /> StateHasChanged?
<br />
<input type="checkbox" @bind="useInvokeAsync" class="form-check-input" /> Use InvokeAsync? --> ohne dies Absturz in Blazor Server ("The current thread is not associated with the Dispatcher.")

<br />
<input type="number" @bind="delay" class="form-control" style="width:100px" /> ms Verzögerung nach dem StateHasChanges() --> in Blazor WebAssembly blockiert das UI

<h3>Ausgaben</h3>

<ITVButton @onclick="Start" AnimationSeconds="100" class="btn btn-info">Start</ITVButton>

<hr />
Verbleibende Sekunden: @VerbleibendeSekunden
<br />
@((MarkupString)Ausgabe)
<br />
@EndeZeit

@DetectChangeDetection

@code {
 private byte Dauer { get; set; } = 3;
 private string Ausgabe { get; set; } = "";
 private string EndeZeit { get; set; } = "";
 private bool shouldRender = true;
 private bool useTask = true;
 private bool useInvokeAsync = true;
 private bool callStateHasChanged = true;

 // Dieses Property dient nur dazu, festzustellen, 
 // wann eine Change Detection stattfindet
 // Es wird im Razor Code verwendet, damit Blazor es als relevant betrachtet
 public string DetectChangeDetection
 {
  get { Util.Log("Change Detection!"); return ""; }
  set { } // wir setzen hier nie einen Wert
 }

 private int delay = 1;
 private int count { get; set; }
 public int VerbleibendeSekunden { get; set; }
 protected override bool ShouldRender() { return shouldRender; }

 public async void Start()
 {
  count = 0;
  VerbleibendeSekunden = Dauer;
  EndeZeit = "";
  DateTime startTime = DateTime.Now;
  DateTime? letzteLogAusgabe = null;

  while ((DateTime.Now - startTime).TotalSeconds < Dauer)
  {
   if (letzteLogAusgabe == null || (DateTime.Now - letzteLogAusgabe.Value).TotalSeconds >= 1)
   {
    letzteLogAusgabe = DateTime.Now;
    VerbleibendeSekunden = (int)(startTime.AddSeconds(Dauer) - DateTime.Now).TotalSeconds;
    Util.Log("Verbleibende Sekunden: " + VerbleibendeSekunden);
   }

   if (!useTask) // ohne eigenen Task
   {
    Aktion();
    if (callStateHasChanged) this.StateHasChanged();
    if (delay > 0) await Task.Delay(delay);
   }
   else
   { // eigenen Task verwenden
    await Task.Run(async () =>
    {
     Aktion();
     await Render();
     if (delay > 0) await Task.Delay(delay);
    });
   }
  } // end while
  EndeZeit = "Beendet um " + DateTime.Now;
  await Render();
 } // end start

 void Aktion()
 {
  count++;
  if (count % 10 == 0) Ausgabe = "";
  string text = $"{count:0000} {DateTime.Now.ToString()} in Thread #{Thread.CurrentThread.ManagedThreadId}";
  Ausgabe += text + "<br>";
  Util.Log(text);
 }

 async Task Render()
 {
  if (useInvokeAsync)
  {
   await this.InvokeAsync(
          async () =>
          {
           if (callStateHasChanged) this.StateHasChanged();
          });
  }
  else
  {
   if (callStateHasChanged) this.StateHasChanged();
  }
 }
}
